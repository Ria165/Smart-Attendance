# Smart Attendance System Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production

# MySQL Database Configuration
# In production with MySQL, provide:
DATABASE_URL=mysql+pymysql://<username>:<password>@localhost:3306/smart_attendance
# Or for local development with SQLite fallback:
# DATABASE_URL=sqlite:///smart_attendance.db

# QR Code Verification Settings
QR_REFRESH_INTERVAL_SECONDS=30
QR_TOKEN_VALIDITY_LEEWAY=10

# Geolocation Settings
DEFAULT_CLASSROOM_RADIUS_METERS=50.0
MAX_GPS_ACCURACY_THRESHOLD_METERS=80.0

# Face Recognition Settings
FACE_SIMILARITY_THRESHOLD=0.65

# Reports & Alerts
LOW_ATTENDANCE_THRESHOLD_PERCENT=75.0

# Security (set to True when deploying behind HTTPS / SSL)
SESSION_COOKIE_SECURE=False
